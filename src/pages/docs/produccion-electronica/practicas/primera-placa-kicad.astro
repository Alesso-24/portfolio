---
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import AnnotatedShot from '../../../../components/docs/AnnotatedShot.astro'
import ModsStep from '../../../../components/docs/ModsStep.astro'
import { MODS_GENERAL, MODS_IMG_BASE, MODS_MAP, MODS_MAP_LEGEND, MODS_OPEN, MODS_FLOWS, MODS_SUMMARY, MODS_FINAL } from '../../../../data/mods-flow'
import { getSubject } from '../../../../data/docs'

const subject = getSubject('produccion-electronica')!
const teamNames = subject.team.map((m) => m.name).join(' + ')

const img = (path: string) => `/portfolio/images/docs/produccion-electronica/practicas/01-primera-placa/${path}`
const monofabImg = '/portfolio/images/docs/produccion-electronica/monofab/srm-20-roland.webp'

const steps = [
  { href: '#objetivo', label: 'Objetivo' },
  { href: '#paso-1', label: '1. Preparación' },
  { href: '#paso-2', label: '2. Editor de esquemas' },
  { href: '#paso-3', label: '3. Organización' },
  { href: '#paso-4', label: '4. Pulsadores' },
  { href: '#paso-5', label: '5. Conectores' },
  { href: '#paso-6', label: '6. Esquemático completo' },
  { href: '#paso-7', label: '7. Editor de placas' },
  { href: '#paso-8', label: '8. Exportación a Gerber' },
  { href: '#paso-9', label: '9. Toolpaths con mods' },
  { href: '#mods-abrir', label: '9.1 Abrir mods' },
  { href: '#mods-periferia', label: '9.2 Periferia' },
  { href: '#mods-pistas', label: '9.3 Pistas' },
  { href: '#mods-orificios', label: '9.4 Orificios' },
  { href: '#mods-resumen', label: '9.5 Resumen' },
  { href: '#fabricacion', label: 'Fabricación en MonoFab' },
]

const tools = [
  {
    icon: img('01-esquematico/herramientas/01-icono-seleccionar-componente.png'),
    name: 'Seleccionar componente',
    desc: 'Abre el buscador de símbolos (22,987 elementos cargados en las librerías) para colocar cualquier componente en el esquemático.',
  },
  {
    icon: img('01-esquematico/herramientas/03-icono-simbolo-alimentacion.png'),
    name: 'Símbolo de alimentación',
    desc: 'Abre el buscador de símbolos de alimentación: tierra, +3V3, +5V, +9V, +12V, +24V, +36V, +48V — incluye los símbolos de la librería PCM_fab que vino con KiCad FabLib.',
  },
  {
    icon: img('01-esquematico/herramientas/05-icono-dibujar-cable.png'),
    name: 'Dibujar cable',
    desc: 'Traza las conexiones eléctricas (wires) entre los pines de los componentes.',
  },
  {
    icon: img('01-esquematico/herramientas/06-icono-etiqueta-de-red.png'),
    name: 'Etiqueta de red',
    desc: 'Nombra una red eléctrica para conectar puntos del esquemático sin necesidad de dibujar un cable físico entre ellos.',
  },
  {
    icon: img('01-esquematico/herramientas/07-icono-texto.png'),
    name: 'Texto',
    desc: 'Agrega texto libre al esquemático (notas, títulos) — abre un diálogo de propiedades con fuente, tamaño, alineación y color.',
  },
]
---

<DocsLayout
  title="Primera placa en KiCad"
  description="Diseño esquemático, ruteo del PCB y fabricación con MonoFab — documentado paso a paso."
  badge="Producción Electrónica · Práctica 01"
  breadcrumbs={[
    { label: 'Documentación', href: '/portfolio/docs' },
    { label: subject.name, href: `/portfolio/docs/${subject.slug}` },
    { label: 'Prácticas', href: `/portfolio/docs/${subject.slug}/practicas` },
  ]}
>
  <!-- Meta row -->
  <div class="callout" data-reveal>
    <strong>Ficha de la práctica</strong>
    <div style="display:flex; flex-wrap:wrap; gap:24px; margin-top:4px;">
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Materia</span>{subject.name}</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Equipo</span>{teamNames}</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Herramientas</span>KiCad · MonoFab</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Estado</span>
        <span class="status-chip status-chip--en-progreso" style="margin-top:2px;"><span class="status-dot"></span>En progreso</span>
      </div>
    </div>
  </div>

  <nav class="step-toc" data-reveal data-reveal-delay="100" aria-label="Pasos de esta práctica">
    {steps.map((s) => (
      <a href={s.href}>{s.label}</a>
    ))}
  </nav>

  <hr class="divider" />

  <!-- ── Nota aparte: instalación de librería, antes del flujo principal ── -->
  <div class="callout" data-reveal>
    <strong>Antes de empezar · Instalar una librería de componentes</strong>
    <p class="prose" style="margin:0 0 14px; font-size:14.5px;">
      Antes de dibujar cualquier esquemático hace falta instalar <strong>KiCad FabLib</strong>: una
      librería de componentes pensada para fabricar PCBs en un Fab Lab estándar, con mapeo 1:1 a las
      piezas del inventario oficial de Fab Lab — reduce la fricción de aprender electrónica y da más
      confianza al prototipar rápido.
    </p>
    <div class="tool-row" style="border-top:none; padding-top:0;">
      <div style="flex:1;">
        <AnnotatedShot
          src={img('00-preparacion/04-menu-herramientas-administrador-complementos.png')}
          alt="Menú Herramientas de KiCad con la opción Administrador de complementos y contenido"
          size={[528, 402]}
          boxes={[
          { x: 6, y: 317, w: 516, h: 34, label: 'Clic aquí' },
          ]}
        />
        <span class="screenshot-caption">Herramientas → Administrador de complementos y contenido (Ctrl+M)</span>
      </div>
    </div>
    <img
      src={img('00-preparacion/05-instalar-kicad-fablib.png')}
      alt="Panel de instalación del complemento KiCad FabLib con sus metadatos"
      class="screenshot"
      loading="lazy"
      decoding="async"
    />
    <p class="prose" style="margin:0; font-size:13px; color:#6f6a5f;">
      Licencia CC-BY-4.0 · Autor: Krisjanis Rijnieks y Fab Academy Community
      (<a href="https://fabacademy.org" target="_blank" rel="noopener noreferrer" style="color:#2540c0;">fabacademy.org</a>) ·
      Fuente: <a href="https://gitlab.fabcloud.org/pub/libraries/electronics/kicad" target="_blank" rel="noopener noreferrer" style="color:#2540c0;">gitlab.fabcloud.org/pub/libraries/electronics/kicad</a>
    </p>
  </div>

  <hr class="divider" />

  <h2 id="objetivo" class="section-h2" data-reveal>Objetivo de la práctica.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Recorrer el flujo completo de fabricación de una PCB: diseñar un circuito en <strong>KiCad</strong>{' '}
    (esquemático y placa), exportar los archivos de fabricación y generar las trayectorias de fresado
    con <strong>mods</strong> para la <strong>Roland SRM-20</strong> (MonoFab).
  </p>
  <p class="prose" data-reveal data-reveal-delay="100">
    El circuito diseñado es un módulo de <strong>4 pulsadores</strong> con LED indicador, cada uno con
    su resistencia pull-down, más un conector de alimentación (entradas) y uno de salidas que expone
    el estado de cada botón hacia un microcontrolador externo.
  </p>

  <hr class="divider" />

  <h2 id="paso-1" class="section-h2" data-reveal>1. Preparación: abrir KiCad y crear el proyecto.</h2>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">1</span>Se abre KiCad — se trabaja con <strong>KiCad 10.0</strong>. La ventana
    principal del proyecto muestra los editores disponibles: Editor de esquemas, Editor de símbolos, Editor
    de placas, Editor de huellas, Visor Gerber, Conversor de imágenes, Herramientas de cálculo, Editor de
    hoja de trabajo, y el Administrador de complementos y contenido.
  </p>
  <img
    src={img('00-preparacion/01-abrir-kicad-ventana-principal.webp')}
    alt="Ventana principal de KiCad 10.0 mostrando los editores disponibles del proyecto"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">2</span>Desde el menú <strong>Archivo → Nuevo proyecto...</strong> (Ctrl+N) se crea
    un proyecto nuevo.
  </p>
  <AnnotatedShot
    src={img('00-preparacion/02-menu-archivo-nuevo-proyecto.png')}
    alt="Menú Archivo de KiCad con la opción Nuevo proyecto"
    size={[580, 588]}
    boxes={[
    { x: 8, y: 35, w: 564, h: 34, label: 'Clic aquí' },
    ]}
  />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">3</span>Se nombra el proyecto <strong>"Hola_Mundo"</strong> — el primer proyecto
    de prueba en KiCad, para familiarizarse con el flujo antes de ir por la placa real. Al crearlo, KiCad
    genera automáticamente <code>Hola_Mundo.kicad_pro</code>, <code>Hola_Mundo.kicad_pcb</code> y <code>Hola_Mundo.kicad_sch</code>.
  </p>
  <img
    src={img('00-preparacion/03-proyecto-hola-mundo-creado.png')}
    alt="Árbol de archivos del proyecto Hola_Mundo recién creado en KiCad"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <hr class="divider" />

  <h2 id="paso-2" class="section-h2" data-reveal>2. Editor de esquemas.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Se entra al <strong>Editor de esquemas</strong> (Ctrl+E) para empezar el esquemático del circuito.
    Arranca con la hoja en blanco, formato A4, con el cuadro de título en la esquina inferior derecha.
  </p>
  <img
    src={img('01-esquematico/00-editor-de-esquemas-vacio.webp')}
    alt="Editor de esquemas de KiCad con una hoja en blanco formato A4"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <div class="callout" data-reveal>
    <strong>Herramientas utilizadas en el esquemático</strong>
    <div class="tool-list">
      {tools.map((tool) => (
        <div class="tool-row">
          <div class="tool-icon-box"><img src={tool.icon} alt="" loading="lazy" decoding="async" /></div>
          <div>
            <h4>{tool.name}</h4>
            <p>{tool.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <AnnotatedShot
    src={img('01-esquematico/herramientas/02-dialogo-elegir-simbolo.png')}
    alt="Diálogo Elegir símbolo del editor de esquemas, con 22,987 elementos cargados"
    wide
    size={[1633, 1036]}
    boxes={[
    { x: 6, y: 52, w: 772, h: 38, label: 'Buscar aquí' },
    ]}
  />
  <span class="screenshot-caption">Buscador de símbolos — herramienta "Seleccionar componente"</span>

  <img
    src={img('01-esquematico/herramientas/04-dialogo-elegir-simbolo-alimentacion.png')}
    alt="Diálogo Elegir símbolo de alimentación, con la librería PCM_fab expandida"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <span class="screenshot-caption">Buscador de símbolos de alimentación — incluye la librería PCM_fab de KiCad FabLib</span>

  <img
    src={img('01-esquematico/herramientas/08-dialogo-propiedades-texto.png')}
    alt="Diálogo de propiedades del texto en el editor de esquemas"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <span class="screenshot-caption">Propiedades del texto — fuente, tamaño, alineación y color</span>

  <hr class="divider" />

  <h2 id="paso-3" class="section-h2" data-reveal>3. Organización del esquema.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Antes de seguir colocando componentes conviene organizar visualmente el esquema. La herramienta <strong>Dibujar rectángulo</strong> agrega un cuadro puramente gráfico — sin ningún efecto
    eléctrico — para delimitar y agrupar visualmente un bloque de componentes relacionados. Se usa
    para separar "Entradas y Salidas" de "Pulsadores" en la vista completa más abajo.
  </p>
  <div class="tool-row" style="border-top:none; padding-top:0;">
    <div class="tool-icon-box"><img src={img('02-organizacion/01-icono-dibujar-cuadro-delimitador.png')} alt="" loading="lazy" decoding="async" /></div>
    <div>
      <h4>Dibujar rectángulo</h4>
      <p>Agrega un cuadro gráfico de organización visual — no genera ninguna conexión eléctrica.</p>
    </div>
  </div>

  <div class="callout" data-reveal data-reveal-delay="100">
    <strong>Atajos de teclado usados seguido</strong>
    <p class="prose" style="margin:0 0 10px; font-size:14.5px;">
      <code>E</code> edita las propiedades de lo seleccionado (o doble click) — sirve para símbolos,
      texto y hasta el propio cuadro delimitador.
    </p>
    <p class="prose" style="margin:0; font-size:14.5px;">
      <code>R</code> rota 90° lo seleccionado — clave para acomodar el layout (switches y
      resistencias en vertical, LEDs en la orientación correcta).
    </p>
  </div>

  <hr class="divider" />

  <h2 id="paso-4" class="section-h2" data-reveal>4. Los pulsadores.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Se construyen <strong>4 módulos idénticos</strong> (S1–S4), uno por cada botón. Cada módulo combina
    un switch táctil, dos resistencias y un LED indicador — este es el circuito completo del módulo
    S3, como ejemplo:
  </p>
  <img
    src={img('03-pulsadores/01-circuito-pulsador-s3-completo.png')}
    alt="Circuito completo de un módulo pulsador: switch SW3, resistencias R5 y R6, LED D4"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <p class="prose" data-reveal data-reveal-delay="60">
    El switch conecta <strong>V3.3</strong> al nodo <code>s3</code>. Desde ahí, una resistencia baja a <strong>GND</strong> — es una <strong>pull-down</strong>: mantiene el nodo en LOW cuando el botón no
    está presionado, en vez de dejarlo flotando. La otra rama sale del mismo nodo por una resistencia
    limitadora hacia un <strong>LED</strong> a GND — se enciende cada vez que el botón está presionado,
    como indicador visual. El nodo <code>sN</code> de cada módulo es lo que sale hacia el conector de
    salidas (siguiente sección).
  </p>
  <div class="callout" data-reveal data-reveal-delay="140">
    <strong>Componentes del módulo pulsador</strong>
    <p class="prose" style="margin:0; font-size:14.5px;">
      Resistencia y LED usan símbolos genéricos de KiCad con huella asignada de la librería del
      proyecto (<code>PCM_fab</code>); el switch usa símbolo y huella propios del proyecto.
    </p>
  </div>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Resistencia</strong></p>
  <img src={img('referencia-componentes/resistencia/01-simbolo-r-1206.png')} alt="Símbolo genérico de resistencia en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — R</span>
  <img src={img('referencia-componentes/resistencia/02-footprint-r-1206.png')} alt="Huella R_1206 SMD de dos pads" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — R_1206 (SMD, 2 pads)</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>LED</strong></p>
  <img src={img('referencia-componentes/led/01-simbolo-led-1206.png')} alt="Símbolo genérico de LED en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — D (LED)</span>
  <img src={img('referencia-componentes/led/02-footprint-led-1206.png')} alt="Huella LED_1206 SMD de dos pads" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — LED_1206 (SMD, 2 pads — ojo con la polaridad ánodo/cátodo)</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Switch táctil</strong></p>
  <img src={img('referencia-componentes/switch/01-simbolo-switch-tactile-omron.png')} alt="Símbolo del switch táctil Omron en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — Switch_Tactile_Omron</span>
  <img src={img('referencia-componentes/switch/02-footprint-button-omron-b3sn.png')} alt="Huella del switch Button_Omron_B3SN de 6x6mm, 4 pads THT" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — Button_Omron_B3SN_6.0x6.0mm (THT, 4 pads en 2 pares)</span>

  <hr class="divider" />

  <h2 id="paso-5" class="section-h2" data-reveal>5. Conectores de entrada y salida.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    La placa se conecta al exterior por dos headers: <strong>J1 "Entradas"</strong> trae la
    alimentación externa (pin 1 = V3.3 vía el símbolo de red <code>PWR_3V3</code>, pin 2 = GND), y <strong>J2 "Salidas"</strong> expone el estado de los 4 pulsadores (pines <code>s1</code>–<code>s4</code>)
    hacia afuera — por ejemplo, a un microcontrolador que los lea.
  </p>
  <img src={img('04-conectores/01-j1-entradas-alimentacion.png')} alt="Conector J1 Entradas: header de 2 pines con V3.3 y GND" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">J1 "Entradas" — alimentación de la placa</span>
  <img src={img('04-conectores/02-j2-salidas-s1-s4.png')} alt="Conector J2 Salidas: header de 4 pines con las señales s1 a s4" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">J2 "Salidas" — estado de los 4 pulsadores</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    Ambos headers usan la misma huella base (paso 2.54 mm, THT), solo cambia el número de pines:
  </p>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Pin header 1×02 (usado en J1)</strong></p>
  <img src={img('referencia-componentes/pin-header-1x02/01-simbolo-pinheader-1x02.png')} alt="Símbolo de pin header de 2 pines en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — PinHeader 1×02</span>
  <img src={img('referencia-componentes/pin-header-1x02/02-footprint-pinheader-1x02.png')} alt="Huella de pin header vertical THT de 2 pines, paso 2.54mm" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — PinHeader_01x02_P2.54mm_Vertical_THT_D1.4mm</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Pin header 1×04 (usado en J2)</strong></p>
  <img src={img('referencia-componentes/pin-header-1x04/01-simbolo-pinheader-1x04.png')} alt="Símbolo de pin header de 4 pines en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — PinHeader 1×04</span>
  <img src={img('referencia-componentes/pin-header-1x04/02-footprint-pinheader-1x04.png')} alt="Huella de pin header vertical THT de 4 pines, paso 2.54mm" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — PinHeader_01x04_P2.54mm_Vertical_THT_D1.4mm</span>

  <hr class="divider" />

  <h2 id="paso-6" class="section-h2" data-reveal>6. Esquemático completo.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Con los 4 pulsadores y los conectores de entrada/salida ya armados, así queda el esquemático
    completo de <code>Hola_Mundo.kicad_sch</code> — dos bloques delimitados con cuadros: "Entradas y
    Salidas" arriba, "Pulsadores" (los 4 módulos en cuadrícula 2×2) debajo.
  </p>
  <img src={img('05-vista-general/01-esquematico-completo-dos-bloques.png')} alt="Esquemático completo con los bloques Entradas y Salidas y Pulsadores delimitados" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('05-vista-general/02-bloque-entradas-y-salidas-zoom.png')} alt="Zoom del bloque Entradas y Salidas con J1 y J2" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Bloque "Entradas y Salidas"</span>
  <img src={img('05-vista-general/03-bloque-pulsadores-4x-zoom.png')} alt="Zoom del bloque Pulsadores con los 4 módulos S1 a S4" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Bloque "Pulsadores" — los 4 módulos S1–S4</span>

  <hr class="divider" />

  <h2 id="paso-7" class="section-h2" data-reveal>7. Editor de placas (PCB).</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Con el esquemático listo, se pasa al <strong>Editor de placas</strong> para diseñar el PCB físico.
  </p>
  <div class="tool-row" style="border-top:none; padding-top:0;">
    <div class="tool-icon-box"><img src={img('06-editor-placas/00-icono-abrir-editor-placas.png')} alt="" loading="lazy" decoding="async" /></div>
    <div>
      <h4>Editor de placas</h4>
      <p>Abre el diseño físico del PCB — colocación de componentes, ruteo de pistas, capas y exportación de fabricación.</p>
    </div>
  </div>

  <p class="prose" data-reveal data-reveal-delay="60">
