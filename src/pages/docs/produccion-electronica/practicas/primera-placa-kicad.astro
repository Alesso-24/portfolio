---
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { getSubject } from '../../../../data/docs'

const subject = getSubject('produccion-electronica')!
const teamNames = subject.team.map((m) => m.name).join(' + ')

const img = (path: string) => `/portfolio/images/docs/produccion-electronica/practicas/01-primera-placa/${path}`
const monofabImg = '/portfolio/images/docs/produccion-electronica/monofab/srm-20-roland.png'

const tools = [
  {
    icon: img('01-esquematico/herramientas/01-icono-seleccionar-componente.png'),
    name: 'Seleccionar componente',
    desc: 'Abre el buscador de símbolos (22,987 elementos cargados en las librerías) para colocar cualquier componente en el esquemático.',
  },
  {
    icon: img('01-esquematico/herramientas/03-icono-simbolo-alimentacion.png'),
    name: 'Símbolo de alimentación',
    desc: 'Abre el buscador de símbolos de alimentación: tierra, +3V3, +5V, +9V, +12V, +24V, +36V, +48V — incluye los símbolos de la librería PCM_fab que vino con KiCad FabLib.',
  },
  {
    icon: img('01-esquematico/herramientas/05-icono-dibujar-cable.png'),
    name: 'Dibujar cable',
    desc: 'Traza las conexiones eléctricas (wires) entre los pines de los componentes.',
  },
  {
    icon: img('01-esquematico/herramientas/06-icono-etiqueta-de-red.png'),
    name: 'Etiqueta de red',
    desc: 'Nombra una red eléctrica para conectar puntos del esquemático sin necesidad de dibujar un cable físico entre ellos.',
  },
  {
    icon: img('01-esquematico/herramientas/07-icono-texto.png'),
    name: 'Texto',
    desc: 'Agrega texto libre al esquemático (notas, títulos) — abre un diálogo de propiedades con fuente, tamaño, alineación y color.',
  },
]
---

<DocsLayout
  title="Nuestra primera placa en KiCad"
  description="Diseño esquemático, ruteo del PCB y fabricación con MonoFab — documentado paso a paso."
  badge="Producción Electrónica · Práctica 01"
  breadcrumbs={[
    { label: 'Documentación', href: '/portfolio/docs' },
    { label: subject.name, href: `/portfolio/docs/${subject.slug}` },
    { label: 'Prácticas', href: `/portfolio/docs/${subject.slug}/practicas` },
  ]}
>
  <!-- Meta row -->
  <div class="callout" data-reveal>
    <strong>Ficha de la práctica</strong>
    <div style="display:flex; flex-wrap:wrap; gap:24px; margin-top:4px;">
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Materia</span>{subject.name}</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Equipo</span>{teamNames}</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Herramientas</span>KiCad · MonoFab</div>
      <div><span style="display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8579; margin-bottom:4px;">Estado</span>
        <span class="status-chip status-chip--en-progreso" style="margin-top:2px;"><span class="status-dot"></span>En progreso</span>
      </div>
    </div>
  </div>

  <div class="todo-callout" data-reveal data-reveal-delay="60">
    <strong>🚧 En construcción</strong>
    Vamos documentando esta práctica conforme avanzamos. El esquemático completo y el PCB ruteado
    (con exportación a Gerber) ya están documentados abajo — la fabricación física en MonoFab y los
    resultados todavía están pendientes al final de la página.
  </div>

  <hr class="divider" />

  <!-- ── Nota aparte: instalación de librería, antes del flujo principal ── -->
  <div class="callout" data-reveal>
    <strong>Antes de empezar · Instalar una librería de componentes</strong>
    <p class="prose" style="margin:0 0 14px; font-size:14.5px;">
      Antes de dibujar cualquier esquemático hace falta instalar <strong>KiCad FabLib</strong>: una
      librería de componentes pensada para fabricar PCBs en un Fab Lab estándar, con mapeo 1:1 a las
      piezas del inventario oficial de Fab Lab — reduce la fricción de aprender electrónica y da más
      confianza al prototipar rápido.
    </p>
    <div class="tool-row" style="border-top:none; padding-top:0;">
      <div style="flex:1;">
        <img
          src={img('00-preparacion/04-menu-herramientas-administrador-complementos.png')}
          alt="Menú Herramientas de KiCad con la opción Administrador de complementos y contenido"
          class="screenshot"
          loading="lazy"
          decoding="async"
          style="margin-bottom:6px;"
        />
        <span class="screenshot-caption">Herramientas → Administrador de complementos y contenido (Ctrl+M)</span>
      </div>
    </div>
    <img
      src={img('00-preparacion/05-instalar-kicad-fablib.png')}
      alt="Panel de instalación del complemento KiCad FabLib con sus metadatos"
      class="screenshot"
      loading="lazy"
      decoding="async"
    />
    <p class="prose" style="margin:0; font-size:13px; color:#6f6a5f;">
      Licencia CC-BY-4.0 · Autor: Krisjanis Rijnieks y Fab Academy Community
      (<a href="https://fabacademy.org" target="_blank" rel="noopener noreferrer" style="color:#2540c0;">fabacademy.org</a>) ·
      Fuente: <a href="https://gitlab.fabcloud.org/pub/libraries/electronics/kicad" target="_blank" rel="noopener noreferrer" style="color:#2540c0;">gitlab.fabcloud.org/pub/libraries/electronics/kicad</a>
    </p>
  </div>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>Objetivo de la práctica.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    <em>TODO: describir qué circuito vamos a diseñar y por qué — qué problema resuelve la placa, qué debe hacer
    eléctricamente, y qué aprendizaje busca esta práctica dentro de la materia.</em>
  </p>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>1. Preparación: abrir KiCad y crear el proyecto.</h2>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">1</span>Abrimos KiCad — trabajamos con <strong>KiCad 10.0</strong>. La ventana
    principal del proyecto muestra los editores disponibles: Editor de esquemas, Editor de símbolos, Editor
    de placas, Editor de huellas, Visor Gerber, Conversor de imágenes, Herramientas de cálculo, Editor de
    hoja de trabajo, y el Administrador de complementos y contenido.
  </p>
  <img
    src={img('00-preparacion/01-abrir-kicad-ventana-principal.png')}
    alt="Ventana principal de KiCad 10.0 mostrando los editores disponibles del proyecto"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">2</span>Desde el menú <strong>Archivo → Nuevo proyecto...</strong> (Ctrl+N) creamos
    un proyecto nuevo.
  </p>
  <img
    src={img('00-preparacion/02-menu-archivo-nuevo-proyecto.png')}
    alt="Menú Archivo de KiCad con la opción Nuevo proyecto"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">3</span>Nombramos el proyecto <strong>"Hola_Mundo"</strong> — nuestro primer proyecto
    de prueba en KiCad, para familiarizarnos con el flujo antes de ir por la placa real. Al crearlo, KiCad
    genera automáticamente <code>Hola_Mundo.kicad_pro</code>, <code>Hola_Mundo.kicad_pcb</code> y
    <code>Hola_Mundo.kicad_sch</code>.
  </p>
  <img
    src={img('00-preparacion/03-proyecto-hola-mundo-creado.png')}
    alt="Árbol de archivos del proyecto Hola_Mundo recién creado en KiCad"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>2. Editor de esquemas.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Entramos al <strong>Editor de esquemas</strong> (Ctrl+E) para empezar el esquemático del circuito.
    Arranca con la hoja en blanco, formato A4, con el cuadro de título en la esquina inferior derecha.
  </p>
  <img
    src={img('01-esquematico/00-editor-de-esquemas-vacio.png')}
    alt="Editor de esquemas de KiCad con una hoja en blanco formato A4"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />

  <div class="callout" data-reveal>
    <strong>Herramientas utilizadas en el esquemático</strong>
    <div class="tool-list">
      {tools.map((tool) => (
        <div class="tool-row">
          <div class="tool-icon-box"><img src={tool.icon} alt="" loading="lazy" decoding="async" /></div>
          <div>
            <h4>{tool.name}</h4>
            <p>{tool.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <img
    src={img('01-esquematico/herramientas/02-dialogo-elegir-simbolo.png')}
    alt="Diálogo Elegir símbolo del editor de esquemas, con 22,987 elementos cargados"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <span class="screenshot-caption">Buscador de símbolos — herramienta "Seleccionar componente"</span>

  <img
    src={img('01-esquematico/herramientas/04-dialogo-elegir-simbolo-alimentacion.png')}
    alt="Diálogo Elegir símbolo de alimentación, con la librería PCM_fab expandida"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <span class="screenshot-caption">Buscador de símbolos de alimentación — incluye la librería PCM_fab de KiCad FabLib</span>

  <img
    src={img('01-esquematico/herramientas/08-dialogo-propiedades-texto.png')}
    alt="Diálogo de propiedades del texto en el editor de esquemas"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <span class="screenshot-caption">Propiedades del texto — fuente, tamaño, alineación y color</span>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>3. Organización del esquema.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Antes de seguir colocando componentes conviene organizar visualmente el esquema. La herramienta
    <strong>Dibujar rectángulo</strong> agrega un cuadro puramente gráfico — sin ningún efecto
    eléctrico — para delimitar y agrupar visualmente un bloque de componentes relacionados. La usamos
    para separar "Entradas y Salidas" de "Pulsadores" en la vista completa más abajo.
  </p>
  <div class="tool-row" style="border-top:none; padding-top:0;">
    <div class="tool-icon-box"><img src={img('02-organizacion/01-icono-dibujar-cuadro-delimitador.png')} alt="" loading="lazy" decoding="async" /></div>
    <div>
      <h4>Dibujar rectángulo</h4>
      <p>Agrega un cuadro gráfico de organización visual — no genera ninguna conexión eléctrica.</p>
    </div>
  </div>

  <div class="callout" data-reveal data-reveal-delay="100">
    <strong>Atajos de teclado que usamos seguido</strong>
    <p class="prose" style="margin:0 0 10px; font-size:14.5px;">
      <code>E</code> edita las propiedades de lo seleccionado (o doble click) — sirve para símbolos,
      texto y hasta el propio cuadro delimitador.
    </p>
    <p class="prose" style="margin:0; font-size:14.5px;">
      <code>R</code> rota 90° lo seleccionado — clave para acomodar el layout (switches y
      resistencias en vertical, LEDs en la orientación correcta).
    </p>
  </div>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>4. Los pulsadores.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Construimos <strong>4 módulos idénticos</strong> (S1–S4), uno por cada botón. Cada módulo combina
    un switch táctil, dos resistencias y un LED indicador — este es el circuito completo del módulo
    S3, como ejemplo:
  </p>
  <img
    src={img('03-pulsadores/01-circuito-pulsador-s3-completo.png')}
    alt="Circuito completo de un módulo pulsador: switch SW3, resistencias R5 y R6, LED D4"
    class="screenshot"
    loading="lazy"
    decoding="async"
  />
  <p class="prose" data-reveal data-reveal-delay="60">
    El switch conecta <strong>V3.3</strong> al nodo <code>s3</code>. Desde ahí, una resistencia baja a
    <strong>GND</strong> — es una <strong>pull-down</strong>: mantiene el nodo en LOW cuando el botón no
    está presionado, en vez de dejarlo flotando. La otra rama sale del mismo nodo por una resistencia
    limitadora hacia un <strong>LED</strong> a GND — se enciende cada vez que el botón está presionado,
    como indicador visual. El nodo <code>sN</code> de cada módulo es lo que sale hacia el conector de
    salidas (siguiente sección).
  </p>
  <div class="todo-callout" data-reveal data-reveal-delay="100">
    <strong>⚠ Pendiente</strong>
    Falta anotar el valor real (ohmiaje) de las resistencias y la referencia/color exacto del LED —
    las capturas solo muestran el nombre de la huella (<code>R_1206</code>, <code>LED_1206</code>),
    no el valor del componente.
  </div>

  <div class="callout" data-reveal data-reveal-delay="140">
    <strong>Componentes del módulo pulsador</strong>
    <p class="prose" style="margin:0; font-size:14.5px;">
      Resistencia y LED usan símbolos genéricos de KiCad con huella asignada de la librería del
      proyecto (<code>PCM_fab</code>); el switch usa símbolo y huella propios del proyecto.
    </p>
  </div>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Resistencia</strong></p>
  <img src={img('referencia-componentes/resistencia/01-simbolo-r-1206.png')} alt="Símbolo genérico de resistencia en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — R</span>
  <img src={img('referencia-componentes/resistencia/02-footprint-r-1206.png')} alt="Huella R_1206 SMD de dos pads" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — R_1206 (SMD, 2 pads)</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>LED</strong></p>
  <img src={img('referencia-componentes/led/01-simbolo-led-1206.png')} alt="Símbolo genérico de LED en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — D (LED)</span>
  <img src={img('referencia-componentes/led/02-footprint-led-1206.png')} alt="Huella LED_1206 SMD de dos pads" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — LED_1206 (SMD, 2 pads — ojo con la polaridad ánodo/cátodo)</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Switch táctil</strong></p>
  <img src={img('referencia-componentes/switch/01-simbolo-switch-tactile-omron.png')} alt="Símbolo del switch táctil Omron en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — Switch_Tactile_Omron</span>
  <img src={img('referencia-componentes/switch/02-footprint-button-omron-b3sn.png')} alt="Huella del switch Button_Omron_B3SN de 6x6mm, 4 pads THT" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — Button_Omron_B3SN_6.0x6.0mm (THT, 4 pads en 2 pares)</span>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>5. Conectores de entrada y salida.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    La placa se conecta al exterior por dos headers: <strong>J1 "Entradas"</strong> trae la
    alimentación externa (pin 1 = V3.3 vía el símbolo de red <code>PWR_3V3</code>, pin 2 = GND), y
    <strong>J2 "Salidas"</strong> expone el estado de los 4 pulsadores (pines <code>s1</code>–<code>s4</code>)
    hacia afuera — por ejemplo, a un microcontrolador que los lea.
  </p>
  <img src={img('04-conectores/01-j1-entradas-alimentacion.png')} alt="Conector J1 Entradas: header de 2 pines con V3.3 y GND" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">J1 "Entradas" — alimentación de la placa</span>
  <img src={img('04-conectores/02-j2-salidas-s1-s4.png')} alt="Conector J2 Salidas: header de 4 pines con las señales s1 a s4" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">J2 "Salidas" — estado de los 4 pulsadores</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    Ambos headers usan la misma huella base (paso 2.54 mm, THT), solo cambia el número de pines:
  </p>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Pin header 1×02 (usado en J1)</strong></p>
  <img src={img('referencia-componentes/pin-header-1x02/01-simbolo-pinheader-1x02.png')} alt="Símbolo de pin header de 2 pines en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — PinHeader 1×02</span>
  <img src={img('referencia-componentes/pin-header-1x02/02-footprint-pinheader-1x02.png')} alt="Huella de pin header vertical THT de 2 pines, paso 2.54mm" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — PinHeader_01x02_P2.54mm_Vertical_THT_D1.4mm</span>

  <p class="prose" data-reveal data-reveal-delay="60"><strong>Pin header 1×04 (usado en J2)</strong></p>
  <img src={img('referencia-componentes/pin-header-1x04/01-simbolo-pinheader-1x04.png')} alt="Símbolo de pin header de 4 pines en KiCad" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Símbolo — PinHeader 1×04</span>
  <img src={img('referencia-componentes/pin-header-1x04/02-footprint-pinheader-1x04.png')} alt="Huella de pin header vertical THT de 4 pines, paso 2.54mm" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Huella — PinHeader_01x04_P2.54mm_Vertical_THT_D1.4mm</span>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>6. Esquemático completo.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Con los 4 pulsadores y los conectores de entrada/salida ya armados, así queda el esquemático
    completo de <code>Hola_Mundo.kicad_sch</code> — dos bloques delimitados con cuadros: "Entradas y
    Salidas" arriba, "Pulsadores" (los 4 módulos en cuadrícula 2×2) debajo.
  </p>
  <img src={img('05-vista-general/01-esquematico-completo-dos-bloques.png')} alt="Esquemático completo con los bloques Entradas y Salidas y Pulsadores delimitados" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('05-vista-general/02-bloque-entradas-y-salidas-zoom.png')} alt="Zoom del bloque Entradas y Salidas con J1 y J2" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Bloque "Entradas y Salidas"</span>
  <img src={img('05-vista-general/03-bloque-pulsadores-4x-zoom.png')} alt="Zoom del bloque Pulsadores con los 4 módulos S1 a S4" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Bloque "Pulsadores" — los 4 módulos S1–S4</span>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>7. Editor de placas (PCB).</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Con el esquemático listo, pasamos al <strong>Editor de placas</strong> para diseñar el PCB físico.
  </p>
  <div class="tool-row" style="border-top:none; padding-top:0;">
    <div class="tool-icon-box"><img src={img('06-editor-placas/00-icono-abrir-editor-placas.png')} alt="" loading="lazy" decoding="async" /></div>
    <div>
      <h4>Editor de placas</h4>
      <p>Abre el diseño físico del PCB — colocación de componentes, ruteo de pistas, capas y exportación de fabricación.</p>
    </div>
  </div>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">1</span>Antes de colocar nada configuramos las reglas de diseño en
    <strong>Configuración de la placa → Reglas de diseño → Requerimientos</strong>: fijamos el
    <strong>margen mínimo de cobre en 0.4 mm</strong> — la separación mínima entre conductores, acorde
    al material y proceso de fresado de la placa — y dejamos el ancho de pista predefinido también en
    0.4 mm (con una opción alternativa de 0.8 mm para pistas de más corriente).
  </p>
  <img src={img('06-editor-placas/00-configuracion-inicial/02-configuracion-placa-reglas-diseno.png')} alt="Diálogo Configuración de la placa, Reglas de diseño, Requerimientos" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('06-editor-placas/00-configuracion-inicial/01-ancho-pista-predefinido.png')} alt="Menú desplegable de anchos de pista predefinidos: 0.400mm y 0.800mm" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Anchos de pista predefinidos</span>

  <div class="callout" data-reveal data-reveal-delay="100">
    <strong>Herramientas de dibujo del editor de placas</strong>
    <div class="tool-list">
      {[
        { icon: img('06-editor-placas/01-herramientas/01-enrutar-pistas.png'), name: 'Enrutar pistas', desc: 'Traza las conexiones de cobre entre pads sobre una capa.' },
        { icon: img('06-editor-placas/01-herramientas/02-zonas-rellenas.png'), name: 'Dibujar zona rellena', desc: 'Crea un plano de cobre sólido dentro de un contorno (ej. relleno de GND o del resto de la placa).' },
        { icon: img('06-editor-placas/01-herramientas/03-rectangulo.png'), name: 'Rectángulo', desc: 'Para cuando la placa se quiere de forma cuadrada o rectangular.' },
        { icon: img('06-editor-placas/01-herramientas/04-poligono.png'), name: 'Polígono', desc: 'Dibuja formas de varios lados (bordes personalizados, zonas irregulares).' },
        { icon: img('06-editor-placas/01-herramientas/05-linea.png'), name: 'Línea', desc: 'Segmento recto simple, en cualquier capa gráfica.' },
        { icon: img('06-editor-placas/01-herramientas/06-arco.png'), name: 'Arco', desc: 'Dibuja arcos — útil para bordes redondeados o rutas curvas.' },
        { icon: img('06-editor-placas/01-herramientas/07-curva-bezier.png'), name: 'Curva Bézier', desc: 'Curvas suaves con puntos de control, para formas más orgánicas.' },
        { icon: img('06-editor-placas/01-herramientas/08-imagen-referencia.png'), name: 'Imagen de referencia', desc: 'Agrega una imagen de referencia sobre el lienzo (ej. para calcar una forma).' },
        { icon: img('06-editor-placas/01-herramientas/09-texto.png'), name: 'Texto', desc: 'Agrega texto libre a cualquier capa (etiquetas, serigrafía).' },
      ].map((tool) => (
        <div class="tool-row">
          <div class="tool-icon-box"><img src={tool.icon} alt="" loading="lazy" decoding="async" /></div>
          <div>
            <h4>{tool.name}</h4>
            <p>{tool.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">2</span><strong>Capas.</strong> <code>F.Cu</code> (cobre superior) es la
    capa principal — ahí vive todo el cobre de este diseño de una sola cara. Las capas
    <code>User.1</code>–<code>User.4</code> son auxiliares: las usamos para marcar perforaciones,
    agregar etiquetas y tener más control a la hora de exportar. <code>Edge.Cuts</code> define el
    contorno físico/corte de la placa.
  </p>
  <img src={img('06-editor-placas/02-capas/01-fcu-capa-principal.png')} alt="Capa F.Cu activa en el panel de capas" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">F.Cu — capa principal</span>
  <img src={img('06-editor-placas/02-capas/03-capas-usuario.png')} alt="Capas User.1 a User.4 en el panel de capas" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">User.1–User.4 — capas auxiliares</span>
  <img src={img('06-editor-placas/02-capas/04-edge-cuts.png')} alt="Capa Edge.Cuts en el panel de capas" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Edge.Cuts — contorno de la placa</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">3</span>Acomodamos primero todos los componentes y ruteamos las pistas
    completas sobre <code>F.Cu</code>:
  </p>
  <img src={img('06-editor-placas/03-componentes-y-rutas/01-board-componentes-y-rutas.png')} alt="PCB con todos los componentes colocados y las pistas ya ruteadas" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">4</span>Le dimos a la placa un borde con esquinas cortadas (forma
    octagonal) en <code>Edge.Cuts</code>, con <strong>2 mm de ancho de línea</strong> — es el trazo que
    sigue la fresadora al cortar el contorno físico de la placa.
  </p>
  <img src={img('06-editor-placas/04-borde-placa-edge-cuts/01-zoom-borde-octagonal.png')} alt="Zoom del borde octagonal de la placa en Edge.Cuts" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('06-editor-placas/04-borde-placa-edge-cuts/02-propiedades-segmento-2mm.png')} alt="Propiedades del segmento del borde: ancho de línea 2mm, capa Edge.Cuts" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Propiedades del segmento — 2 mm, capa Edge.Cuts</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">5</span>Antes de eso, dibujamos la forma de la placa en <code>F.Cu</code> y
    usamos la herramienta de <strong>zona rellena</strong> — todo el cobre no usado por las pistas
    queda como un plano sólido (se ve todo en rojo):
  </p>
  <img src={img('06-editor-placas/05-relleno-zona-fcu/01-board-relleno-rojo.png')} alt="PCB completo con la zona de cobre rellena en F.Cu, todo en rojo" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">6</span>Marcamos las perforaciones en <code>User.4</code> con círculos de
    0.7 mm de radio y relleno <strong>sólido</strong> (junto a los pads de salidas, por ejemplo):
  </p>
  <img src={img('06-editor-placas/06-perforaciones-user4/02-zoom-salidas-perforacion.png')} alt="Zoom de los pads de J2 Salidas con un círculo blanco marcando una perforación en User.4" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('06-editor-placas/06-perforaciones-user4/01-propiedades-circulo-user4.png')} alt="Propiedades del círculo: capa User.4, radio 0.7mm, relleno sólido" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Propiedades del círculo — User.4, radio 0.7 mm</span>
  <img src={img('06-editor-placas/06-perforaciones-user4/03-opciones-relleno-solido.png')} alt="Opciones de relleno: Ninguno, Sólida, Rayado, Rayado inverso, Rayado cruzado" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Relleno — Sólida</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">7</span>Las etiquetas (<code>VCC</code>, <code>GND</code>,
    <code>S1</code>–<code>S4</code>) las pusimos directo en <code>F.Cu</code>:
  </p>
  <img src={img('06-editor-placas/07-etiquetas-fcu/01-zoom-vcc-gnd.png')} alt="Zoom de las etiquetas VCC y GND junto al conector J1, en F.Cu" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">8</span>Y así queda el resultado final del PCB: forma octagonal, plano de
    cobre, pistas, etiquetas y los headers J1/J2.
  </p>
  <img src={img('06-editor-placas/08-resultado-final/01-board-final.png')} alt="PCB terminado: forma octagonal, cobre rojo, pistas, etiquetas VCC/GND/S1-S4" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('06-editor-placas/08-resultado-final/02-board-final-editor-completo.png')} alt="Vista del editor de placas completo con el PCB terminado" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Editor de placas — resultado final</span>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>8. Exportación a Gerber.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">1</span>Desde <strong>Archivo → Salidas de fabricación → Gerbers...</strong>
  </p>
  <img src={img('06-editor-placas/09-exportacion-gerbers/01-menu-salidas-fabricacion.png')} alt="Menú Archivo, Salidas de fabricación, con la opción Gerbers" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">2</span>En el diálogo <strong>Trazar</strong>, cambiamos el formato de
    trazado a <strong>SVG</strong> e incluimos solo las capas que se usaron en cada archivo: pistas
    (<code>F.Cu</code> + <code>Edge.Cuts</code>) y perforaciones/periferia
    (<code>Edge.Cuts</code> + <code>User.4</code>).
  </p>
  <img src={img('06-editor-placas/09-exportacion-gerbers/02-dialogo-trazar-gerber.png')} alt="Diálogo Trazar, con formato Gerber y las opciones generales" class="screenshot" loading="lazy" decoding="async" />
  <img src={img('06-editor-placas/09-exportacion-gerbers/03-formato-svg.png')} alt="Menú de formato de trazado con SVG seleccionado" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Formato de trazado — SVG</span>
  <img src={img('06-editor-placas/09-exportacion-gerbers/04-capas-fcu-edgecuts.png')} alt="Selección de capas F.Cu y Edge.Cuts para el archivo de pistas" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Capas para "Pistas" — F.Cu + Edge.Cuts</span>
  <img src={img('06-editor-placas/09-exportacion-gerbers/05-capas-edgecuts-user4.png')} alt="Selección de capas Edge.Cuts y User.4 para los archivos de periferia y horificios" class="screenshot" loading="lazy" decoding="async" />
  <span class="screenshot-caption">Capas para "Periferia"/"Horificios" — Edge.Cuts + User.4</span>

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">3</span>Muy importante: activar <strong>"Ajustar página a la placa"</strong>
    en las opciones de SVG.
  </p>
  <img src={img('06-editor-placas/09-exportacion-gerbers/06-opciones-svg-ajustar-pagina.png')} alt="Opciones SVG con Ajustar página a la placa activado" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">4</span>Damos <strong>Trazar</strong> y luego <strong>Guardar</strong> — los
    archivos se generan en la carpeta del proyecto:
  </p>
  <img src={img('06-editor-placas/09-exportacion-gerbers/09-archivos-generados.png')} alt="Archivos SVG generados en la carpeta del proyecto: Edge_Cuts, F_Cu, User_4" class="screenshot" loading="lazy" decoding="async" />

  <p class="prose" data-reveal data-reveal-delay="60">
    <span class="step-num">5</span>Como buena práctica, les cambiamos el nombre a algo descriptivo:
    <strong>HORIFICIOS</strong> (perforaciones, capa User.4), <strong>PERIFERIA</strong> (contorno,
    Edge.Cuts) y <strong>PISTAS</strong> (cobre, F.Cu).
  </p>
  <img src={img('06-editor-placas/09-exportacion-gerbers/10-archivos-renombrados.png')} alt="Archivos renombrados: HORIFICIOS, PERIFERIA, PISTAS" class="screenshot" loading="lazy" decoding="async" />
  <div style="display:flex; gap:16px; flex-wrap:wrap; margin: 8px 0 40px;">
    <div style="flex:1; min-width:140px;">
      <img src={img('06-editor-placas/09-exportacion-gerbers/11-horificios-preview.png')} alt="Vista previa del SVG de horificios: puntos de perforación" style="width:100%; border-radius:14px; border:1px solid rgba(33,31,26,0.1);" loading="lazy" decoding="async" />
      <span style="display:block; margin-top:6px; font-size:12.5px; color:#8a8579; text-align:center;">HORIFICIOS</span>
    </div>
    <div style="flex:1; min-width:140px;">
      <img src={img('06-editor-placas/09-exportacion-gerbers/12-periferia-preview.png')} alt="Vista previa del SVG de periferia: contorno octagonal de la placa" style="width:100%; border-radius:14px; border:1px solid rgba(33,31,26,0.1);" loading="lazy" decoding="async" />
      <span style="display:block; margin-top:6px; font-size:12.5px; color:#8a8579; text-align:center;">PERIFERIA</span>
    </div>
    <div style="flex:1; min-width:140px;">
      <img src={img('06-editor-placas/09-exportacion-gerbers/13-pistas-preview.png')} alt="Vista previa del SVG de pistas: cobre y trazas del circuito" style="width:100%; border-radius:14px; border:1px solid rgba(33,31,26,0.1);" loading="lazy" decoding="async" />
      <span style="display:block; margin-top:6px; font-size:12.5px; color:#8a8579; text-align:center;">PISTAS</span>
    </div>
  </div>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>Fabricación en MonoFab.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    <strong>MonoFab</strong> es la <strong>Roland SRM-20</strong>: una fresadora CNC de escritorio que
    usamos para fabricar PCBs por fresado a partir de los archivos SVG que exportamos arriba
    (<code>HORIFICIOS</code>, <code>PERIFERIA</code>, <code>PISTAS</code>).
  </p>
  <img
    src={monofabImg}
    alt="Fresadora Roland SRM-20 (MonoFab)"
    class="screenshot"
    loading="lazy"
    decoding="async"
    style="max-width:420px;"
  />
