---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { getSubject } from '../../../data/docs'

const subject = getSubject('produccion-electronica')!
---

<DocsLayout
  title={subject.name}
  description={subject.description}
  badge="Producción Electrónica"
  breadcrumbs={[{ label: 'Documentación', href: '/portfolio/docs' }]}
  ogImage="https://alesso-24.github.io/portfolio/images/Alessandro.webp"
>
  <h2 class="section-h2" data-reveal>Nuestro equipo.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    La materia se trabaja en parejas: diseñamos, ruteamos y fabricamos las placas juntos.
  </p>

  <div class="team-grid" data-reveal data-reveal-delay="100">
    {subject.team.map((member) => (
      member.photo ? (
        <div class="team-card">
          <img src={member.photo} alt={`Foto de ${member.name}`} class="team-photo" loading="lazy" decoding="async" />
          <h3>{member.name}</h3>
          <p class="team-role">{member.role}</p>
          {member.bio && <p>{member.bio}</p>}
        </div>
      ) : (
        <div class="team-card">
          <div class="team-photo team-photo--placeholder" role="img" aria-label="Foto pendiente">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke-linecap="round" />
            </svg>
          </div>
          <h3>{member.name}</h3>
          <p class="team-role">{member.role}</p>
          {member.bio && <p>{member.bio}</p>}
        </div>
      )
    ))}
  </div>

  <hr class="divider" />

  <h2 class="section-h2" data-reveal>Sobre la materia.</h2>
  <p class="prose" data-reveal data-reveal-delay="60">
    Producción Electrónica es la materia de <strong>producir PCBs</strong> (placas de circuito impreso). Aquí se documenta
    completa: el diseño en <strong>KiCad</strong>, la fabricación en <strong>MonoFab</strong> y <strong>Altium</strong>.
  </p>

  <a href={`/portfolio/docs/${subject.slug}/practicas`} class="docs-cta" data-reveal data-reveal-delay="100">
    Ver la documentación
    <span aria-hidden="true">→</span>
  </a>
</DocsLayout>
