---
import Base from './Base.astro'
import T from '../components/docs/T.astro'
import { en } from '../data/i18n'

interface Crumb { label: string; href: string }

interface Props {
  title: string
  description: string
  badge: string
  breadcrumbs: Crumb[]
  ogImage?: string
  /** columna de lectura más ancha (guías paso a paso con capturas en dos columnas) */
  wide?: boolean
}

const { title, description, badge, breadcrumbs, ogImage, wide = false } = Astro.props
const backHref = breadcrumbs[breadcrumbs.length - 1]?.href ?? '/portfolio/docs'
const backLabel = breadcrumbs[breadcrumbs.length - 1]?.label ?? 'Documentación'
---

<Base
  title={`${title} | Alessandro Reyes`}
  titleEn={`${en(title)} | Alessandro Reyes`}
  description={description}
  lang="es"
  ogImage={ogImage}
  canonical={`https://alesso-24.github.io${Astro.url.pathname}`}
>
  <article>
    <header class="docs-header">
      <a href={backHref} class="back-link">
        <span>←</span>
        <span><T es={backLabel} /></span>
      </a>

      <div data-reveal class="badge-row">
        <span class="dot"></span>
        <T es={badge} />
      </div>

      <h1 data-reveal data-reveal-delay="80" class="docs-title"><T es={title} /></h1>

      {description && (
        <p data-reveal data-reveal-delay="160" class="docs-lede"><T es={description} /></p>
      )}
    </header>

    <div class={`docs-body${wide ? ' docs-body--wide' : ''}`}>
      <slot />
    </div>
  </article>
</Base>

<style>
  .docs-header {
    padding: clamp(120px, 18vh, 180px) clamp(24px, 5vw, 80px) clamp(48px, 7vh, 80px);
    max-width: 1100px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex; align-items: center; gap: 8px;
    font: 600 11px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: #6f6a5f; text-decoration: none;
    min-height: 44px; margin: -12px 0 calc(clamp(28px, 4vh, 48px) - 12px);
    transition: color 0.2s;
  }
  .back-link:hover { color: #ea6a2e; }
  .back-link:focus-visible { outline: 2px solid #2540c0; outline-offset: 4px; border-radius: 4px; }

  .badge-row {
    display: flex; align-items: center; gap: 12px;
    font: 600 11px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #6f6a5f; margin-bottom: clamp(16px, 2.5vh, 28px);
  }
  .badge-row .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #2540c0; flex-shrink: 0;
  }

  .docs-title {
    margin: 0 0 clamp(20px, 3vh, 32px);
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(30px, 4.6vw, 68px); line-height: 1.04;
    letter-spacing: -0.015em; max-width: 20ch;
    color: #211f1a;
  }

  .docs-lede {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.65;
    color: #534f46;
  }
</style>

<!-- is:global: cascade into <slot /> content scoped to .docs-body -->
<style is:global>
  .docs-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px) clamp(80px, 12vh, 140px);
  }

  .docs-body.docs-body--wide { max-width: 1080px; }

  .docs-body h2.section-h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #211f1a;
    margin: clamp(56px, 8vh, 90px) 0 clamp(16px, 2.2vh, 24px);
  }

  .docs-body p.prose {
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.75;
    color: #534f46;
    margin: 0 0 clamp(16px, 2.2vh, 22px);
    max-width: 70ch;
  }

  .docs-body hr.divider {
    border: none;
    border-top: 1px solid rgba(33, 31, 26, 0.1);
    margin: clamp(40px, 6vh, 64px) 0;
  }

  /* ── TODO / pending callout ── */
  .docs-body .todo-callout {
    background: rgba(234, 106, 46, 0.06);
    border: 1px dashed rgba(234, 106, 46, 0.4);
    border-radius: 14px;
    padding: clamp(18px, 2.6vw, 26px);
    margin: clamp(20px, 3vh, 32px) 0;
    font-size: clamp(13px, 1.1vw, 14.5px);
    line-height: 1.65;
    color: #534f46;
  }
  .docs-body .todo-callout strong {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: #ea6a2e; margin-bottom: 10px;
  }

  /* ── Image placeholder slot ── */
  .docs-body .img-placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px;
    aspect-ratio: 16/9;
    border-radius: 18px;
    border: 1.5px dashed rgba(33, 31, 26, 0.22);
    background: rgba(33, 31, 26, 0.03);
    color: #8a8579;
    margin: clamp(18px, 2.5vh, 28px) 0 clamp(36px, 5.5vh, 56px);
    text-align: center;
    padding: 20px;
  }
  .docs-body .img-placeholder svg { opacity: 0.55; }
  .docs-body .img-placeholder span {
    font: 600 11px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.08em; text-transform: uppercase;
  }

  /* ── Real screenshot (filled-in step) ──
     Capped so a small dialog/node crop doesn't stretch to the full 800px column;
     .screenshot--wide opts back in for full-desktop shots and board photos that
     need the width to stay legible. */
  .docs-body .screenshot {
    display: block;
    width: auto;
    height: auto;
    max-width: min(640px, 100%);
    max-height: 440px;
    object-fit: contain;
    border-radius: 14px;
    border: 1px solid rgba(33, 31, 26, 0.1);
    box-shadow: 0 30px 70px -36px rgba(33, 31, 26, 0.28);
    margin: clamp(16px, 2.2vh, 24px) auto clamp(32px, 5vh, 52px);
  }
  .docs-body .screenshot--wide {
    max-width: 100%;
    max-height: 560px;
  }
  .docs-body .screenshot-caption {
    display: block;
    margin: -20px 0 clamp(32px, 5vh, 52px);
    font-size: 12.5px;
    color: #8a8579;
    text-align: center;
  }

  /* ── Shot grid: 2-3 related screenshots side by side instead of stacked ── */
  .docs-body .shot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    /* start: an annotated shot must not stretch to its neighbour's height — its
       orange boxes are positioned in % of the wrapper, so any extra height shifts them */
    align-items: start;
    margin: clamp(16px, 2.2vh, 24px) 0 clamp(32px, 5vh, 52px);
  }
  .docs-body .shot-grid .screenshot,
  .docs-body .shot-grid .shot-annotated {
    margin: 0 auto;
    max-width: 100%;
  }
  /* width/height stay auto so tall, narrow crops scale down proportionally
     instead of stretching to the cell width and getting squashed by max-height */
  .docs-body .shot-grid .screenshot { max-height: 260px; width: auto; height: auto; }
  .docs-body .shot-grid .screenshot-caption { margin: 8px 0 0; text-align: center; }

  /* ── Annotated screenshot: highlight box + label pointing at what to click/change ── */
  .docs-body .shot-annotated {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: clamp(16px, 2.2vh, 24px) auto clamp(32px, 5vh, 52px);
  }
  /* max-width:100% keeps the img exactly the wrapper's size — the boxes are
     positioned in % of the wrapper, so any overflow would misalign them */
  .docs-body .shot-annotated .screenshot { margin: 0; display: block; max-width: 100%; }
  .docs-body .shot-annotation {
    position: absolute;
    border: 2.5px solid #ea6a2e;
    border-radius: 6px;
    background: rgba(234, 106, 46, 0.1);
    box-shadow: 0 0 0 3px rgba(234, 106, 46, 0.14);
    pointer-events: none;
  }
  .docs-body .shot-annotation__label {
    position: absolute;
    top: -13px;
    left: -2px;
    transform: translateY(-100%);
    background: #ea6a2e;
    color: #f3ede1;
    font: 700 11px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.01em;
    padding: 4px 9px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .docs-body .shot-annotation__label--bottom {
    top: auto; bottom: -13px; left: -2px;
    transform: translateY(100%);
  }
  .docs-body .shot-annotation__label--right {
    top: 50%; left: calc(100% + 12px);
    transform: translateY(-50%);
  }
  .docs-body .shot-annotation__label--left {
    top: 50%; left: auto; right: calc(100% + 12px);
    transform: translateY(-50%);
  }

  /* ── Guía de mods: subsecciones, valores clave y tabla resumen ── */
  .docs-body h3.mods-h3 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #211f1a;
    margin: clamp(48px, 7vh, 72px) 0 clamp(12px, 1.8vh, 18px);
    padding-top: clamp(20px, 3vh, 28px);
    border-top: 1px solid rgba(33, 31, 26, 0.1);
    scroll-margin-top: 90px;
  }
  .docs-body .mods-step { margin: 0 0 clamp(28px, 4vh, 44px); }
  .docs-body .mods-step > .prose { margin-bottom: clamp(12px, 1.6vh, 16px); }
  .docs-body .mods-step .screenshot-caption strong { color: #534f46; font-weight: 700; }
  .docs-body .kicad-where { margin: 0 0 clamp(8px, 1.5vh, 16px); }
  .docs-body .kicad-where__pair { display: flex; gap: 14px; align-items: flex-start; justify-content: center; margin-bottom: 30px; }
  .docs-body .kicad-where--pair .kicad-where__main { flex: 1 1 0; min-width: 0; }
  .docs-body .kicad-where--pair .kicad-where__zoom { flex: 0 0 auto; }
  .docs-body .kicad-where--pair .shot-annotated { margin: 0 auto; }
  .docs-body .kicad-where--pair .kicad-where__zoom .screenshot { max-height: 520px; }
  .docs-body .kicad-where--stack .kicad-where__pair { flex-direction: column; align-items: stretch; gap: 0; margin-bottom: 0; }
  .docs-body ol.mods-legend {
    list-style: none; margin: -18px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 6px 18px;
    font-size: 13.5px; color: #534f46;
  }
  .docs-body ol.mods-legend b {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; margin-right: 6px; border-radius: 50%;
    background: #ea6a2e; color: #f3ede1; font-size: 11px;
  }
  .docs-body .mods-values {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin: 0 0 clamp(20px, 3vh, 30px);
  }
  .docs-body .mods-chip {
    display: inline-flex; flex-direction: column; gap: 2px;
    padding: 9px 14px;
    background: #efe7d8; border: 1px solid rgba(33, 31, 26, 0.08); border-radius: 12px;
    font: 600 14px 'Hanken Grotesk', system-ui, sans-serif; color: #211f1a;
  }
  .docs-body .mods-chip small {
    font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #ea6a2e;
  }
  .docs-body .mods-table-wrap {
    overflow-x: auto; margin: clamp(16px, 2.2vh, 24px) 0 clamp(24px, 3.5vh, 36px);
    border: 1px solid rgba(33, 31, 26, 0.1); border-radius: 14px; background: #efe7d8;
  }
  .docs-body table.mods-table { width: 100%; border-collapse: collapse; font-size: 13.5px; line-height: 1.5; min-width: 600px; }
  .docs-body table.mods-table th, .docs-body table.mods-table td {
    padding: 11px 14px; text-align: left; vertical-align: top; color: #534f46;
    border-bottom: 1px solid rgba(33, 31, 26, 0.08);
  }
  .docs-body table.mods-table thead th {
    font: 700 10.5px 'Hanken Grotesk', system-ui, sans-serif; letter-spacing: 0.1em; text-transform: uppercase; color: #ea6a2e;
  }
  .docs-body table.mods-table tbody th { color: #211f1a; font-weight: 700; white-space: nowrap; }
  .docs-body table.mods-table tbody tr:last-child th, .docs-body table.mods-table tbody tr:last-child td { border-bottom: none; }

  /* ── Step jump menu ── */
  .docs-body .step-toc {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 10px;
    margin: clamp(20px, 3vh, 32px) 0;
  }
  .docs-body .step-toc a {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px; border-radius: 12px;
    background: #efe7d8; border: 1px solid rgba(33, 31, 26, 0.08);
    font: 600 13px 'Hanken Grotesk', system-ui, sans-serif;
    color: #211f1a; text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .docs-body .step-toc a:hover { border-color: rgba(37, 64, 192, 0.4); color: #2540c0; transform: translateY(-1px); }
  .docs-body .step-toc a:focus-visible { outline: 2px solid #2540c0; outline-offset: 3px; }
  .docs-body .step-toc .step-toc__num {
    font-family: 'Instrument Serif', serif; font-size: 18px; color: #2540c0; flex-shrink: 0; min-width: 18px;
  }

  /* ── Collapsible step group (wraps screenshots, keeps prose always visible) ── */
  .docs-body details.step-group {
    border: 1px solid rgba(33, 31, 26, 0.1);
    border-radius: 16px;
    margin: clamp(16px, 2.2vh, 24px) 0 clamp(32px, 5vh, 52px);
    background: #efe7d8;
    overflow: hidden;
  }
  .docs-body details.step-group summary {
    cursor: pointer;
    list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 20px;
    font: 700 13.5px 'Hanken Grotesk', system-ui, sans-serif;
    color: #211f1a;
    -webkit-tap-highlight-color: transparent;
  }
  .docs-body details.step-group summary::-webkit-details-marker { display: none; }
  .docs-body details.step-group summary::after {
    content: '+';
    font-size: 18px; line-height: 1; color: #2540c0; flex-shrink: 0;
  }
  .docs-body details.step-group[open] summary::after { content: '\2212'; }
  .docs-body details.step-group summary:focus-visible { outline: 2px solid #2540c0; outline-offset: -2px; }
  .docs-body details.step-group .step-group__body {
    padding: 4px 20px 20px;
    border-top: 1px solid rgba(33, 31, 26, 0.08);
  }
  .docs-body details.step-group .step-group__body > *:first-child { margin-top: 16px; }
  .docs-body details.step-group .step-group__body > *:last-child { margin-bottom: 0; }

  /* ── Step number badge ── */
  .docs-body .step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 50%;
    background: #2540c0; color: #f3ede1;
    font: 700 13px 'Hanken Grotesk', system-ui, sans-serif;
    margin-right: 10px; flex-shrink: 0;
  }

  /* ── Tool row (icon + label + description) ── */
  .docs-body .tool-row {
    display: flex; align-items: flex-start; gap: 16px;
    padding: clamp(16px, 2vw, 20px) 0;
    border-top: 1px solid rgba(33, 31, 26, 0.1);
  }
  .docs-body .tool-list .tool-row:last-child { border-bottom: 1px solid rgba(33, 31, 26, 0.1); }
  .docs-body .tool-icon-box {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 10px;
    background: #efe7d8; border: 1px solid rgba(33, 31, 26, 0.08);
    flex-shrink: 0; overflow: hidden;
  }
  .docs-body .tool-icon-box img { width: 26px; height: 26px; object-fit: contain; }
  .docs-body .tool-row h4 {
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-weight: 700; font-size: 14.5px; color: #211f1a; margin: 2px 0 5px;
  }
  .docs-body .tool-row p {
    font-size: 13.5px; line-height: 1.6; color: #6f6a5f; margin: 0; max-width: 60ch;
  }

  /* ── Callout box (neutral info) ── */
  .docs-body .callout {
    background: rgba(37, 64, 192, 0.05);
    border: 1px solid rgba(37, 64, 192, 0.14);
    border-radius: 14px;
    padding: clamp(20px, 2.8vw, 32px);
    margin: clamp(28px, 4vh, 44px) 0;
    font-size: clamp(14px, 1.15vw, 15.5px);
    line-height: 1.7;
    color: #534f46;
  }
  .docs-body .callout strong {
    display: block;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: #2540c0; margin-bottom: 10px;
  }

  /* ── Team grid (portada de la materia) ── */
  .docs-body .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
    margin: clamp(24px, 3.5vh, 40px) 0;
  }
  .docs-body .team-card {
    background: #efe7d8;
    border-radius: 18px;
    padding: clamp(22px, 2.8vw, 30px);
    border: 1px solid rgba(33, 31, 26, 0.07);
  }
  .docs-body .team-card .team-photo {
    width: 76px; height: 76px; border-radius: 50%;
    object-fit: cover; margin-bottom: 16px;
    background: #dcd3bf;
  }
  .docs-body .team-card .team-photo--placeholder {
    display: flex; align-items: center; justify-content: center;
    border: 1.5px dashed rgba(33, 31, 26, 0.25);
    color: #8a8579;
  }
  .docs-body .team-card h3 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(19px, 2vw, 24px); line-height: 1.2;
    color: #211f1a; margin: 0 0 4px;
  }
  .docs-body .team-card .team-role {
    font: 600 11px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: #2540c0; margin: 0 0 12px;
  }
  .docs-body .team-card p {
    font-size: 14px; line-height: 1.65; color: #6f6a5f; margin: 0;
  }

  /* ── Practice list rows ── */
  .docs-body .practice-list { margin: clamp(20px, 3vh, 32px) 0; }
  .docs-body .practice-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; text-decoration: none;
    padding: clamp(20px, 2.6vw, 26px) 0;
    border-top: 1px solid rgba(33, 31, 26, 0.1);
    transition: opacity 0.2s;
  }
  .docs-body .practice-list a.practice-row:last-child { border-bottom: 1px solid rgba(33, 31, 26, 0.1); }
  .docs-body .practice-row:hover { opacity: 0.7; }
  .docs-body .practice-row:focus-visible { outline: 2px solid #2540c0; outline-offset: 4px; border-radius: 8px; }
  .docs-body .practice-row .practice-num {
    font-family: 'Instrument Serif', serif; font-size: clamp(24px, 2.6vw, 34px);
    color: #2540c0; min-width: 40px;
  }
  .docs-body .practice-row .practice-main { flex: 1; }
  .docs-body .practice-row h3 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(18px, 1.9vw, 24px); color: #211f1a; margin: 0 0 6px;
  }
  .docs-body .practice-row p {
    font-size: 13.5px; line-height: 1.5; color: #6f6a5f; margin: 0; max-width: 52ch;
  }
  .docs-body .status-chip {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 14px; border-radius: 100px;
    font: 600 10.5px 'Hanken Grotesk', system-ui, sans-serif;
    letter-spacing: 0.08em; text-transform: uppercase;
    white-space: nowrap; flex-shrink: 0;
  }
  .docs-body .status-chip--en-progreso { background: rgba(234, 106, 46, 0.1); color: #ea6a2e; }
  .docs-body .status-chip--completa { background: rgba(37, 64, 192, 0.1); color: #2540c0; }
  .docs-body .status-chip .status-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  /* ── Subject cards (hub /docs) ── */
  .docs-body .subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(16px, 2.5vw, 26px);
    margin: clamp(20px, 3vh, 32px) 0;
  }
  .docs-body .subject-card {
    display: block; text-decoration: none;
    background: #efe7d8; border-radius: 18px;
    padding: clamp(24px, 3vw, 32px);
    border: 1px solid rgba(33, 31, 26, 0.07);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s;
  }
  .docs-body .subject-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px -30px rgba(37, 64, 192, 0.35);
  }
  .docs-body .subject-card:focus-visible { outline: 2px solid #2540c0; outline-offset: 4px; }
  .docs-body .subject-card .subject-icon { color: #2540c0; margin-bottom: 18px; }
  .docs-body .subject-card h3 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(20px, 2.2vw, 28px); color: #211f1a; margin: 0 0 8px;
  }
  .docs-body .subject-card p {
    font-size: 14px; line-height: 1.6; color: #6f6a5f; margin: 0;
  }

  /* ── CTA button ── */
  .docs-body .docs-cta {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 26px; border-radius: 100px;
    background: #2540c0; color: #f3ede1; text-decoration: none;
    font: 600 14px 'Hanken Grotesk', system-ui, sans-serif;
