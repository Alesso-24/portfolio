---
import '../styles/global.css'
import Nav from '../components/layout/Nav'
import Footer from '../components/layout/Footer.astro'

interface Props {
  title?: string
  /** título de la pestaña en cada idioma (si falta, se usa `title`) */
  titleEn?: string
  titleEs?: string
  description?: string
  lang?: 'en' | 'es'
  ogImage?: string
  canonical?: string
}

const HOME_TITLE_EN = 'Alessandro Reyes, Mechatronics Engineer | Embedded AI & Robotics'
const HOME_TITLE_ES = 'Alessandro Reyes, Ingeniero Mecatrónico | IA Embebida y Robótica'

const {
  title = HOME_TITLE_EN,
  titleEn,
  titleEs = title === HOME_TITLE_EN ? HOME_TITLE_ES : undefined,
  description = 'Mechatronics engineer building AI that survives contact with real hardware. 2× IEEE author (CASE 2026, BDAI 2026), LARC 2025 competitive robotics. Open to Summer 2026 internships.',
  lang = 'en',
  ogImage = 'https://alesso-24.github.io/portfolio/og-image.png',
  canonical = 'https://alesso-24.github.io/portfolio/',
} = Astro.props
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Idioma guardado por el visitante (ES/EN): se aplica antes de pintar para que no haya parpadeo.
         Si no hay preferencia guardada, manda el idioma por defecto de la página. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('lang');
        if (saved === 'en' || saved === 'es') document.documentElement.setAttribute('lang', saved);
      } catch (e) {}
    </script>
    <!-- Lo que no puede llevar dos idiomas en el HTML (alt, aria-label, title y el <title> de la pestaña) se cambia con
         el idioma activo al cargar y cada vez que se pulsa ES/EN. Cada elemento lleva data-<atributo>-en y/o -es;
         el atributo que falta es el que trae el elemento en el idioma por defecto de la página. -->
    <script is:inline>
      (function () {
        function apply() {
          var lang = document.documentElement.getAttribute('lang') === 'es' ? 'es' : 'en';
          var other = lang === 'es' ? 'en' : 'es';
          ['alt', 'aria-label', 'title'].forEach(function (attr) {
            document.querySelectorAll('[data-' + attr + '-en],[data-' + attr + '-es]').forEach(function (el) {
              var key = '__' + attr + 'Orig';
              if (el[key] === undefined) el[key] = el.getAttribute(attr) || '';
              var v = el.getAttribute('data-' + attr + '-' + lang);
              el.setAttribute(attr, v !== null ? v : el[key]);
            });
          });
          var t = document.querySelector('title[data-en]');
          if (t) document.title = t.getAttribute('data-' + lang) || document.title;
        }
        window.addEventListener('lang-change', apply);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
        else apply();
      })();
    </script>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formsubmit.co; frame-src https://www.youtube-nocookie.com; form-action https://formsubmit.co; base-uri 'self'; object-src 'none';" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title data-en={titleEn ?? title} data-es={titleEs ?? title}>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg?v=1.0.1" />

    <!-- Open Graph -->
    <meta property="og:type"              content="website" />
    <meta property="og:url"               content={canonical} />
    <meta property="og:title"             content={title} />
    <meta property="og:description"       content={description} />
    <meta property="og:image"             content={ogImage} />
    <meta property="og:image:width"       content="1200" />
    <meta property="og:image:height"      content="630" />
    <meta property="og:locale"            content={lang === 'en' ? 'en_US' : 'es_MX'} />
    <meta property="og:locale:alternate"  content={lang === 'en' ? 'es_MX' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:url"         content={canonical} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Theme color -->
    <meta name="theme-color" content="#f3ede1" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Alessandro Reyes",
        "url": canonical,
        "jobTitle": "Mechatronics Engineer",
        "alumniOf": "Universidad Iberoamericana Puebla",
        "sameAs": [
          "https://github.com/Alesso-24",
          "https://www.linkedin.com/in/alessandro-reyes-mtz/"
        ]
      })}
    </script>
  </head>

  <body class="bg-cream text-ink overflow-x-hidden">
    <!-- Capa ambiental de Liquid Glass (ver src/styles/glass.css): da algo que ver a través del vidrio -->
    <div class="glass-ambient" aria-hidden="true"></div>

    <!-- Skip to main content (a11y) -->
    <a href="#main-content" class="skip-link"><span class="lang-en">Skip to main content</span><span class="lang-es">Saltar al contenido</span></a>

    <!-- Navigation (React island, needs client JS for mobile menu + lang toggle) -->
    <Nav client:idle={{ timeout: 800 }} lang={lang} />

    <!-- Page content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Reflejo del vidrio que sigue al puntero (solo escritorio) -->
    <script>
      import '../scripts/glass-sheen'
      import '../scripts/glass-refract'
    </script>

    <!-- Lenis smooth scroll + GSAP ScrollTrigger setup -->
    <script>
      import Lenis from 'lenis'
      import gsap from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      let lenis: Lenis | null = null

      if (!prefersReduced) {
        lenis = new Lenis({ lerp: 0.1, duration: 1.2, smoothWheel: true })
        lenis.on('scroll', ScrollTrigger.update)
        gsap.ticker.add((time) => lenis?.raf(time * 1000))
        gsap.ticker.lagSmoothing(0)
      }

      // Scroll reveals: [data-reveal] elements animate in
      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]')

      if (!prefersReduced) {
        reveals.forEach((el) => {
          const delay = parseFloat(el.dataset.revealDelay ?? '0') / 1000

          gsap.fromTo(
            el,
            { opacity: 0, y: 28, scale: 0.988 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 1.05,
              delay,
              ease: 'expo.out',
              // GSAP deja un transform en línea al terminar; se limpia para que el hover de las
              // tarjetas de vidrio (.glass-lift: translateY) siga funcionando.
              onComplete: () => { gsap.set(el, { clearProps: 'transform' }) },
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                once: true,
              },
            }
          )

          // Safety fallback: force visible after 4.5s in case observer never fires
          setTimeout(() => {
            if (getComputedStyle(el).opacity === '0') {
              gsap.set(el, { opacity: 1, y: 0, scale: 1, clearProps: 'transform' })
            }
          }, 4500)
        })

        // Hero parallax
        const heroText = document.querySelector<HTMLElement>('[data-parallax="hero-text"]')
        const heroBg   = document.querySelector<HTMLElement>('[data-parallax="hero-bg"]')

        if (heroText) {
          gsap.to(heroText, {
            yPercent: 16,
            opacity: 0.4,
            ease: 'none',
            scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true },
          })
        }

        if (heroBg) {
          gsap.to(heroBg, {
            yPercent: 26,
            ease: 'none',
            scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true },
          })
        }

        // Number counters
        document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
          const raw     = el.dataset.counter ?? '0'
          const suffix  = raw.replace(/[\d.]/g, '')
          const numStr  = raw.replace(/[^\d.]/g, '')
          const num     = parseFloat(numStr)
          const isInt   = Number.isInteger(num)
          const decPts  = numStr.includes('.') ? numStr.split('.')[1].length : 0
          const obj     = { val: 0 }

          gsap.to(obj, {
            val: num,
            duration: 1.8,
            ease: 'power2.out',
            onUpdate: () => {
              el.textContent = (isInt ? Math.round(obj.val) : obj.val.toFixed(decPts)) + suffix
            },
            scrollTrigger: { trigger: el, start: 'top 85%', once: true },
          })
        })

        // Recalculate trigger positions once late-loading images/fonts settle,
        // otherwise reveal/parallax points drift out of sync with actual layout.
        window.addEventListener('load', () => ScrollTrigger.refresh())
        document.fonts?.ready.then(() => ScrollTrigger.refresh())

      } else {
        // Reduced motion: show all reveals immediately
        reveals.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none' })
      }
    </script>
  </body>
</html>
