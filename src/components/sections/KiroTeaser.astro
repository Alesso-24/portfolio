---
import KiroEyes from '../ui/KiroEyes.astro'
---

<section id="kiro" style="padding:clamp(60px,9vh,110px) clamp(20px,4vw,60px) 0;">
  <a href="/portfolio/project/kiro" class="kiro-teaser" data-reveal>
    <div class="kiro-teaser__copy">
      <div class="kiro-teaser__tag">
        <span class="dot"></span>
        <span class="lang-en">Coming soon · Next project</span>
        <span class="lang-es">Próximamente · Siguiente proyecto</span>
      </div>
      <h2>
        <span class="lang-en">Meet <em>Kiro.</em></span>
        <span class="lang-es">Conoce a <em>Kiro.</em></span>
      </h2>
      <p>
        <span class="lang-en">A tiny pet with two flat, colorful eyes that feel when you move it. Its own circular PCB, its own firmware, its own birth. It is already alive in your browser: move the mouse.</span>
        <span class="lang-es">Una mascota diminuta con dos ojos planos y de color que sienten cuando la mueves. Su propia PCB circular, su propio firmware, su propio nacimiento. Ya está viva en tu navegador: mueve el mouse.</span>
      </p>
      <ul class="kiro-teaser__chips">
        <li>XIAO RP2350</li><li>Altium</li><li>GC9A01</li><li>LIS3DHTR</li><li>50–60 fps</li>
      </ul>
      <span class="kiro-teaser__cta">
        <span class="lang-en">See the project</span><span class="lang-es">Ver el proyecto</span> <span aria-hidden="true">→</span>
      </span>
    </div>
    <div class="kiro-teaser__eyes ke-dark">
      <KiroEyes size={360} />
    </div>
  </a>
</section>

<style is:global>
  .kiro-teaser {
    max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(20px,4vw,60px);
    align-items: center; text-decoration: none; color: #efe9dc; border-radius: 26px; overflow: hidden;
    padding: clamp(28px,5vw,64px);
    background: radial-gradient(90% 120% at 85% 40%, #1d1d25 0%, #0b0b0d 65%);
    box-shadow: 0 40px 90px -40px rgba(0,0,0,.65); transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s;
  }
  @media (hover: hover) { .kiro-teaser:hover { transform: translateY(-4px); box-shadow: 0 50px 100px -40px rgba(0,0,0,.75); } }
  .kiro-teaser:focus-visible { outline: 3px solid #ea6a2e; outline-offset: 4px; }
  .kiro-teaser__tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 18px;
    font: 600 11px 'Hanken Grotesk', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #a49f93; }
  .kiro-teaser__tag .dot { width: 8px; height: 8px; border-radius: 50%; background: #ea6a2e; animation: kpulse 1.6s ease-in-out infinite; }
  .kiro-teaser h2 { margin: 0 0 16px; font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(40px,6vw,92px); line-height: .96; letter-spacing: -.01em; }
  .kiro-teaser h2 em { font-style: italic; color: #4de3ff; }
  .kiro-teaser p { margin: 0 0 20px; max-width: 52ch; font-size: clamp(15px,1.3vw,17px); line-height: 1.6; color: #b9b3a6; }
  .kiro-teaser__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 26px; padding: 0; }
  .kiro-teaser__chips li { font: 600 12px 'Hanken Grotesk', system-ui, sans-serif; letter-spacing: .05em; padding: 6px 12px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.16); color: #d8d2c4; }
  .kiro-teaser__cta { display: inline-flex; gap: 8px; font: 600 14px 'Hanken Grotesk', system-ui, sans-serif; letter-spacing: .06em;
    background: #ea6a2e; color: #fff; padding: 12px 22px; border-radius: 999px; }
  @media (max-width: 820px) {
    .kiro-teaser { grid-template-columns: 1fr; }
    .kiro-teaser__eyes { order: -1; }
  }
</style>
