---
import AnnotatedShot from './AnnotatedShot.astro'
import Shot from './Shot.astro'
import T from './T.astro'
import { en } from '../../data/i18n'
import { KICAD_VIEWS } from '../../data/kicad-where'
import { KICAD_COMPONENTS, KICAD_EDITORS } from '../../data/kicad-flow'
import { MODS_GENERAL, MODS_NODES, MODS_NODE_LABEL, MODS_MAP, MODS_MAP_LEGEND, MODS_SUMMARY } from '../../data/mods-flow'
import { MODS_DIR } from '../../data/mods-adapter'
import { imgUrl, sizeOf, MONOFAB_PHOTO, PRACTICA_BASE } from '../../data/flow-utils'
import type { Block } from '../../data/flow-types'

interface Props {
  block: Block
}

type Pos = 'top' | 'bottom' | 'left' | 'right'
type Rect = { x: number; y: number; w: number; h: number; pos: Pos; short?: string }

const { block } = Astro.props

// En los recuadros de las capturas la etiqueta va corta: sin la etiqueta en español entre paréntesis
const enLabel = (s: string) => en(s).replace(/\s*\([^)]*\)\s*$/, '')

// —— where: vista general de KiCad con recuadros sobre lo que se toca ——
let whereBoxes: { x: number; y: number; w: number; h: number; pos: Pos; label: string; labelEn: string }[] = []
let whereView: (typeof KICAD_VIEWS)[keyof typeof KICAD_VIEWS] | null = null
let whereLegend: string[] = []
let whereCaption = ''
let whereCaptionEn = ''
if (block.kind === 'where') {
  whereView = KICAD_VIEWS[block.view]
  const cat = whereView.items as Record<string, Rect>
  whereBoxes = block.items.map((name, i) => {
    const it = cat[name]
    if (!it) throw new Error(`where: "${name}" no existe en la vista "${block.view}"`)
    return { x: it.x, y: it.y, w: it.w, h: it.h, pos: it.pos, label: block.numbered ? String(i + 1) : `Aquí: ${it.short ?? name}`, labelEn: block.numbered ? String(i + 1) : `Here: ${enLabel(it.short ?? name)}` }
  })
  whereLegend = block.numbered ? block.items : []
  whereCaption = block.caption ?? (block.numbered ? 'Dónde están, en la ventana completa' : `Dónde está: ${block.items[0]}`)
  whereCaptionEn = block.caption
    ? en(block.caption)
    : block.numbered ? 'Where they are, in the full window' : `Where it is: ${en(block.items[0])}`
}

// —— tools: ventana completa con números + leyenda con íconos grandes ——
let toolBoxes: { x: number; y: number; w: number; h: number; pos: Pos; label: string; labelEn: string }[] = []
let toolView: (typeof KICAD_VIEWS)[keyof typeof KICAD_VIEWS] | null = null
let toolLegend: { name: string; desc: string; icon: string; num: number | null; hint?: string }[] = []
if (block.kind === 'tools') {
  toolView = KICAD_VIEWS[block.view]
  const cat = toolView.items as Record<string, Rect>
  let n = 0
  toolLegend = block.tools.map((t) => {
    const it = cat[t.key ?? t.name]
    const num = it ? ++n : null
    if (it) toolBoxes.push({ x: it.x, y: it.y, w: it.w, h: it.h, pos: it.pos, label: String(num), labelEn: String(num) })
    return { name: t.name, desc: t.desc, icon: t.icon, num, hint: t.hint }
  })
}

// —— shots ——
let shotsLayout: 'single' | 'row' | 'thumbs' | 'carousel' = 'single'
if (block.kind === 'shots') {
  const n = block.shots.length
  shotsLayout = !block.layout || block.layout === 'auto' ? (n === 1 ? 'single' : n === 2 ? 'row' : 'carousel') : block.layout
}

// —— node (mods) ——
const nodeName = block.kind === 'node' ? ((MODS_NODE_LABEL as Record<string, string>)[block.node] ?? block.node) : ''
const nodeBox = block.kind === 'node' ? [{ ...(MODS_NODES as Record<string, { x: number; y: number; w: number; h: number }>)[block.node], label: `Aquí: ${nodeName}`, labelEn: `Here: ${enLabel(nodeName)}`, pos: 'top' as Pos }] : []
const generalFile = MODS_DIR + MODS_GENERAL.file
---

{block.kind === 'where' && whereView && (
  <div class="flow-where">
    <figure class="shot shot--lead">
      <AnnotatedShot src={imgUrl(whereView.file)} alt={`${whereView.alt}. Recuadros naranjas: ${block.items.join(', ')}.`} altEn={`${en(whereView.alt)}. Orange boxes: ${block.items.map((n) => en(n)).join(', ')}.`} size={whereView.size} boxes={whereBoxes} wide />
      <figcaption class="screenshot-caption"><T es={whereCaption} en={whereCaptionEn} /></figcaption>
    </figure>
    {whereLegend.length > 0 && (
      <ol class="mods-legend">
        {whereLegend.map((n, i) => (
          <li><b>{i + 1}</b> <T es={n} /></li>
        ))}
      </ol>
    )}
    {block.note && <p class="lead-note"><T es={block.note} /></p>}
  </div>
)}

{block.kind === 'node' && (
  <figure class="shot shot--lead">
    <AnnotatedShot src={imgUrl(generalFile)} alt={`${MODS_GENERAL.alt}. Recuadro naranja sobre el nodo ${block.node}.`} altEn={`${en(MODS_GENERAL.alt)}. Orange box on the ${block.node} node.`} size={MODS_GENERAL.size} boxes={nodeBox} wide />
    <figcaption class="screenshot-caption"><T es={`Dónde está: nodo <strong>${block.node}</strong> en el grafo completo`} en={`Where it is: <strong>${block.node}</strong> node in the full graph`} /></figcaption>
  </figure>
)}

{block.kind === 'shots' && shotsLayout === 'single' && <Shot shot={block.shots[0]} />}
{block.kind === 'shots' && (shotsLayout === 'row' || shotsLayout === 'thumbs') && (
  <div class={`shots shots--${shotsLayout}`}>
    {block.shots.map((s) => <Shot shot={s} />)}
  </div>
)}
{block.kind === 'shots' && shotsLayout === 'carousel' && (
  <div class="carousel" data-carousel>
    <div class="carousel__viewport">
      {block.shots.map((s, i) => (
        <div class={`carousel__slide${i === 0 ? ' is-active' : ''}`}>
          <Shot shot={s} />
        </div>
      ))}
    </div>
    <div class="carousel__bar">
      <button type="button" class="carousel__btn" data-cdir="-1" aria-label="Imagen anterior" data-aria-label-en="Previous image">‹</button>
      <span class="carousel__dots" aria-hidden="true">
        {block.shots.map((_, i) => <i class={i === 0 ? 'is-active' : ''}></i>)}
      </span>
      <span class="carousel__count" aria-live="polite">1 / {block.shots.length}</span>
      <button type="button" class="carousel__btn" data-cdir="1" aria-label="Imagen siguiente" data-aria-label-en="Next image">›</button>
    </div>
  </div>
)}

{block.kind === 'tools' && toolView && (
  <div class="flow-tools">
    <figure class="shot shot--lead">
      <AnnotatedShot src={imgUrl(toolView.file)} alt={`${toolView.alt}. Recuadros naranjas numerados sobre cada herramienta.`} altEn={`${en(toolView.alt)}. Numbered orange boxes on each tool.`} size={toolView.size} boxes={toolBoxes} wide />
      {block.caption && <figcaption class="screenshot-caption"><T es={block.caption} /></figcaption>}
    </figure>
    <ul class="tools-legend">
      {toolLegend.map((t) => (
        <li>
          <span class={`legend-num${t.num ? '' : ' legend-num--none'}`}>{t.num ?? '·'}</span>
          <span class="legend-icon"><img src={imgUrl(t.icon)} alt="" loading="lazy" decoding="async" /></span>
          <span class="legend-text"><strong><T es={t.name} /></strong><T es={t.desc} />{t.hint && <em class="legend-hint"><T es={t.hint} /></em>}</span>
        </li>
      ))}
    </ul>
  </div>
)}

{block.kind === 'toolrow' && (
  <div class="tool-feature">
    <span class="legend-icon legend-icon--lg"><img src={imgUrl(block.icon)} alt="" loading="lazy" decoding="async" /></span>
    <span class="legend-text"><strong><T es={block.name} /></strong><T es={block.desc} /></span>
  </div>
)}

{block.kind === 'editors' && (
  <ul class="editors-grid">
    {KICAD_EDITORS.map((e) => (
      <li class={e.used ? 'is-used' : ''}>
        <img src={`${PRACTICA_BASE}00-preparacion/editores/${e.key}.webp`} alt="" width="72" height="72" loading="lazy" decoding="async" />
        <span><strong><T es={e.name} /></strong><T es={e.desc} />{e.used && <em class="used-chip"><T es="se usa aquí" en="used here" /></em>}</span>
      </li>
    ))}
  </ul>
)}

{block.kind === 'components' && (
  <div class="components-grid">
    {KICAD_COMPONENTS.map((c) => (
      <article class="component-card">
        <header><h4><T es={c.name} /></h4><span class="used-chip"><T es={c.used} /></span></header>
        <div class="component-card__pair">
          <figure>
            <button type="button" class="thumb-zoom" data-zoom={imgUrl(c.sym.file)} data-zoom-alt={c.sym.alt} data-zoom-alt-en={en(c.sym.alt)}>
              <img src={imgUrl(c.sym.file)} alt={c.sym.alt} data-alt-en={en(c.sym.alt)} width={sizeOf(c.sym.file)[0]} height={sizeOf(c.sym.file)[1]} loading="lazy" decoding="async" />
            </button>
            <figcaption><b><T es="Símbolo" en="Symbol" /></b><T es={c.sym.label} /></figcaption>
          </figure>
          <figure>
            <button type="button" class="thumb-zoom" data-zoom={imgUrl(c.fp.file)} data-zoom-alt={c.fp.alt} data-zoom-alt-en={en(c.fp.alt)}>
              <img src={imgUrl(c.fp.file)} alt={c.fp.alt} data-alt-en={en(c.fp.alt)} width={sizeOf(c.fp.file)[0]} height={sizeOf(c.fp.file)[1]} loading="lazy" decoding="async" />
            </button>
            <figcaption><b><T es="Huella" en="Footprint" /></b><T es={c.fp.label} /></figcaption>
          </figure>
        </div>
      </article>
    ))}
  </div>
)}

{block.kind === 'callout' && (
  <div class="callout">
    <strong><T es={block.title} /></strong>
    <T es={block.html} />
  </div>
)}

{block.kind === 'important' && (
  <div class="todo-callout">
    <strong>⚠ <T es="Importante" en="Important" /></strong>
    <T es={block.html} />
  </div>
)}

{block.kind === 'note' && <p class="lead-note"><T es={block.html} /></p>}

{block.kind === 'map' && (
  <div class="flow-where">
    <figure class="shot shot--lead">
      <AnnotatedShot src={imgUrl(generalFile)} alt={MODS_GENERAL.alt} size={MODS_GENERAL.size} boxes={MODS_MAP} wide />
      <figcaption class="screenshot-caption"><T es={'Grafo "Roland Monofab PCB": los nodos que se tocan, numerados'} /></figcaption>
    </figure>
    <ol class="mods-legend">
      {MODS_MAP_LEGEND.map((n, i) => (
        <li><b>{i + 1}</b> <T es={n} /></li>
      ))}
    </ol>
  </div>
)}

{block.kind === 'summary' && (
  <div class="mods-table-wrap">
    <table class="mods-table">
      <thead>
        <tr>{MODS_SUMMARY.head.map((h) => <th><T es={h} /></th>)}</tr>
      </thead>
      <tbody>
        {MODS_SUMMARY.rows.map((row) => (
          <tr>{row.map((c, k) => (k === 0 ? <th scope="row">{c}</th> : <td><T es={c} /></td>))}</tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{block.kind === 'machine' && (
  <figure class="machine-figure">
    <img src={MONOFAB_PHOTO} alt="Fresadora Roland SRM-20 (MonoFab)" data-alt-en="Roland SRM-20 milling machine (MonoFab)" width="800" height="533" loading="lazy" decoding="async" />
    <figcaption class="screenshot-caption">Roland SRM-20 (MonoFab)</figcaption>
  </figure>
)}
