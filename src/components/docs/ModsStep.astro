---
import AnnotatedShot from './AnnotatedShot.astro'
import { MODS_GENERAL, MODS_NODES, MODS_NODE_LABEL, MODS_IMG_BASE, type ModsStep } from '../../data/mods-flow'

interface Props {
  step: ModsStep
  n: number
}

const { step, n } = Astro.props
const url = (f: string) => MODS_IMG_BASE + f
const nodeBoxes = step.node ? [{ ...MODS_NODES[step.node], label: `Aquí: ${MODS_NODE_LABEL[step.node] ?? step.node}`, pos: 'top' as const }] : null
---

<div class="mods-step" data-reveal>
  <p class="prose"><span class="step-num">{n}</span><Fragment set:html={step.html} /></p>

  {nodeBoxes && (
    <>
      <AnnotatedShot
        src={url(MODS_GENERAL.file)}
        alt={`${MODS_GENERAL.alt}. Recuadro naranja sobre el nodo ${step.node}.`}
        size={MODS_GENERAL.size}
        boxes={nodeBoxes}
        wide
      />
      <span class="screenshot-caption">Dónde está: nodo <strong>{step.node}</strong> en el grafo completo</span>
    </>
  )}

  {step.shots.map((shot) => (
    <>
      <AnnotatedShot
        src={url(shot.file)}
        alt={shot.alt}
        size={shot.size}
        boxes={shot.boxes ?? []}
        wide={shot.wide}
      />
      {shot.caption && <span class="screenshot-caption">{shot.caption}</span>}
    </>
  ))}

  {step.important && (
    <div class="todo-callout">
      <strong>⚠ Importante</strong>
      <Fragment set:html={step.important} />
    </div>
  )}
</div>
