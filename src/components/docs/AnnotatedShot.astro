---
import T from './T.astro'
import { en } from '../../data/i18n'

interface Box {
  /** pixel coords in the source image (requires `size`) */
  x: number
  y: number
  w: number
  h: number
  label: string
  /** etiqueta en inglés (si falta, se busca en docs-en.ts) */
  labelEn?: string
  /** where the label sits relative to the box (default: above) */
  pos?: 'top' | 'bottom' | 'left' | 'right'
  /** vertical nudge for the label, in CSS px (negative = up) */
  nudge?: number
}

interface Props {
  src: string
  alt: string
  /** alt en inglés (si falta, se busca en docs-en.ts) */
  altEn?: string
  /** natural pixel size of the source image [width, height] — boxes are measured against it */
  size: [number, number]
  boxes: Box[]
  /** opt into the wider screenshot cap (full-desktop shots) */
  wide?: boolean
}

const { src, alt, altEn, size, boxes, wide = false } = Astro.props
const [W, H] = size
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`
---

<span class="shot-annotated">
  <img
    src={src}
    alt={alt}
    data-alt-en={altEn ?? en(alt)}
    width={W}
    height={H}
    class={`screenshot${wide ? ' screenshot--wide' : ''}`}
    loading="lazy"
    decoding="async"
  />
  {boxes.map((b) => (
    <span
      class="shot-annotation"
      style={`left:${pct(b.x, W)}; top:${pct(b.y, H)}; width:${pct(b.w, W)}; height:${pct(b.h, H)};`}
    >
      <span
        class={`shot-annotation__label${b.pos ? ` shot-annotation__label--${b.pos}` : ''}`}
        style={b.nudge ? `margin-top:${b.nudge}px;` : undefined}
      ><T es={b.label} en={b.labelEn} /></span>
    </span>
  ))}
</span>
