---
interface Box {
  /** all in %, relative to the image's own box */
  left: number
  top: number
  width: number
  height: number
  label: string
}

interface Props {
  src: string
  alt: string
  boxes: Box[]
  /** opt into the wider screenshot cap (full-desktop shots) */
  wide?: boolean
}

const { src, alt, boxes, wide = false } = Astro.props
---

<span class="shot-annotated">
  <img
    src={src}
    alt={alt}
    class={`screenshot${wide ? ' screenshot--wide' : ''}`}
    loading="lazy"
    decoding="async"
  />
  {boxes.map((b) => (
    <span
      class="shot-annotation"
      style={`left:${b.left}%; top:${b.top}%; width:${b.width}%; height:${b.height}%;`}
    >
      <span class="shot-annotation__label">{b.label}</span>
    </span>
  ))}
</span>
