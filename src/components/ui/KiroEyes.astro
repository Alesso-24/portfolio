---
// Kiro en vivo: es el MOTOR REAL del estudio (kiro_v4, el mismo que se porta al firmware) incrustado sin panel.
// Props: controls = botones de expresión; size = ancho máx. en px.
interface Props { controls?: boolean; size?: number }
const { controls = false, size = 420 } = Astro.props
const EXPR: [string, string, string][] = [
  ['auto', 'Auto', 'Automático'], ['curioso', 'Curious', 'Curioso'], ['feliz', 'Happy', 'Feliz'], ['amor', 'In love', 'Amor'],
  ['enojado', 'Angry', 'Enojado'], ['triste', 'Sad', 'Triste'], ['sorprendido', 'Surprised', 'Sorprendido'],
  ['orgulloso', 'Proud', 'Orgulloso'], ['hype', 'Hype', 'Hype'], ['ansioso', 'Anxious', 'Ansioso'], ['mareado', 'Dizzy', 'Mareado'],
  ['frio', 'Cold', 'Frío'], ['bostezo', 'Yawn', 'Bostezo'], ['guino', 'Wink', 'Guiño'], ['electrico', 'Electric', 'Eléctrico'],
  ['dormido', 'Asleep', 'Dormido'], ['nacimiento', 'Birth', 'Nacimiento'],
]
---

<div class="kiro-eyes" style={`--ke-size:${size}px`}>
  <iframe class="ke-frame" src="/portfolio/kiro/lab/kiro_embed.html" title="Kiro" data-title-en="Kiro, live" loading="lazy" tabindex="-1"></iframe>
  {controls && (
    <div class="ke-chips" role="group" aria-label="Expresión" data-aria-label-en="Expression">
      {EXPR.map(([k, en, es]) => (
        <button type="button" class="ke-chip" data-expr={k} aria-pressed={k === 'auto' ? 'true' : 'false'}>
          <span class="lang-en">{en}</span><span class="lang-es">{es}</span>
        </button>
      ))}
    </div>
  )}
</div>

<style is:global>
  .kiro-eyes { width: 100%; max-width: var(--ke-size, 420px); margin: 0 auto; }
  .kiro-eyes .ke-frame { width: 100%; aspect-ratio: 1; border: 0; display: block; background: transparent; color-scheme: normal; }
  .kiro-eyes .ke-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: clamp(20px,3vw,30px); }
  .kiro-eyes .ke-chip {
    font: 600 12px 'Hanken Grotesk', system-ui, sans-serif; letter-spacing: .04em;
    padding: 8px 14px; border-radius: 999px; cursor: pointer;
    background: rgba(255,255,255,.6); border: 1px solid rgba(33,31,26,.14); color: #211f1a;
    transition: transform .15s, background .15s, color .15s;
  }
  .kiro-eyes .ke-chip:hover { transform: translateY(-2px); }
  .kiro-eyes .ke-chip[aria-pressed="true"] { background: #211f1a; color: #f3ecdd; border-color: #211f1a; }
  .kiro-eyes .ke-chip:focus-visible { outline: 2px solid #2540c0; outline-offset: 3px; }
  .ke-dark .ke-chip { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.16); color: #efe9dc; }
  .ke-dark .ke-chip[aria-pressed="true"] { background: #efe9dc; color: #0b0b0d; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.kiro-eyes').forEach((root) => {
    const fr = root.querySelector('iframe') as HTMLIFrameElement
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.ke-chip')]
    const post = (m: object) => fr.contentWindow?.postMessage(m, location.origin)
    let ready = false
    fr.addEventListener('load', () => { ready = true })
    chips.forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.expr!
      post(id === 'auto' ? { t: 'auto' } : { t: 'expr', id })
      chips.forEach((o) => o.setAttribute('aria-pressed', String(o === b)))
    }))
    // la mirada sigue al mouse en toda la página (el iframe solo ve el mouse dentro de él)
    addEventListener('pointermove', (e) => {
      if (!ready) return
      const r = fr.getBoundingClientRect()
      const x = (e.clientX - (r.left + r.width / 2)) / Math.max(r.width, 300) * 2
      const y = (e.clientY - (r.top + r.height / 2)) / Math.max(r.height, 300) * 2
      post({ t: 'mouse', x, y })
    }, { passive: true })
    document.addEventListener('pointerleave', () => post({ t: 'leave' }))
  })
</script>
